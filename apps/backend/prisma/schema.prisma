datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  HOSTEL_ADMIN
  ASSISTANT_WARDEN
  WARDEN
  MESS_MANAGER
  SECURITY
  MAINTENANCE
  ACCOUNTANT
  LAUNDRY
  STUDENT
  WORKER
  STAFF
}

enum StaffType {
  SECURITY
  LAUNDRY
  MAINTENANCE
  ELECTRICIAN
  PLUMBER
  CLEANING
  MESS
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  RESOLVED
  VERIFIED
  REOPENED
  CANCELLED
}


enum RoomCategory {
  AC
  NON_AC
  PREMIUM
  DORMITORY
}

enum GatePassStatus {
  PENDING
  APPROVED
  REJECTED
  EXITED
  RETURNED
}

enum NoticeAudience {
  ALL
  STUDENTS
  STAFF
  HOSTEL_ADMIN
  MESS_MANAGER
  SECURITY
  MAINTENANCE
}

model Hostel {
  id           String   @id @default(uuid()) @map("_id")
  name         String
  code         String   @unique
  collegeName  String
  address      String
  capacity     Int
  phone        String?
  email        String?
  logo         String?
  gender       String?  @default("MIXED")
  academicYear String?  @default("2025-2026")
  status       String?  @default("ACTIVE")
  wardenId     String?
  latitude     Float?   @default(13.0827)
  longitude    Float?   @default(80.2707)
  locationCode String?  @default("HSTL-MAIN-001")
  allowedRadius Float?  @default(5.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  rooms              Room[]
  complaints         Complaint[]
  laundrySlots       LaundrySlot[]
  messMenus          MessMenu[]
  visitors           Visitor[]
  messes             Mess[]
  fees               Fee[]
  payments           Payment[]
  inventories        Inventory[]
  inventoryUsages    InventoryUsage[]
  inventoryPurchases InventoryPurchase[]
  expenses           Expense[]
  payrolls           Payroll[]
  documents          Document[]
  leaves             Leave[]
  gatePasses         GatePass[]
  notices            Notice[]
  emergencies        EmergencyAlert[]
  meals              Meal[]
}

model User {
  id               String     @id @default(uuid()) @map("_id")
  email            String     @unique
  passwordHash     String
  plainPassword    String?
  fullName         String
  mobileNumber     String
  role             Role
  status           String     @default("PENDING")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  qrToken          String?    @unique
  isDeleted        Boolean    @default(false)

  collegeName      String?
  department       String?
  year             String?
  registerNumber   String?
  gender           String?
  parentName       String?
  parentMobile     String?
  emergencyContact String?
  address          String?

  photo            String?
  bloodGroup       String?
  medicalDetails   String?
  guardianName     String?
  guardianMobile   String?
  guardianRelation String?

  qualification    String?
  experience       String?
  staffType        StaffType?

  // Hostel lifecycle status (additive)
  hostelStatus     String?    @default("REGISTERED")
  admissionId      String?

  hostelId         String?
  hostel           Hostel?    @relation(fields: [hostelId], references: [id])

  roomId           String?
  room             Room?      @relation(fields: [roomId], references: [id])

  bedNumber        String?
  allocationDate   DateTime?
  checkOutDate     DateTime?
  checkOutReason   String?

  messId           String?
  mess             Mess?      @relation(fields: [messId], references: [id])

  attendances        Attendance[]
  attendanceQRs      AttendanceQR[]
  leaves             Leave[]
  complaintsRaised   Complaint[]      @relation("StudentComplaints")
  complaintsAssigned Complaint[]      @relation("StaffComplaints")
  workerAssignedComplaints Complaint[] @relation("WorkerComplaints")
  laundryBookings    LaundrySlot[]
  laundryWaitlists   LaundryWaitlist[]
  visitors           Visitor[]
  fees               Fee[]
  payments           Payment[]
  messAttendances    MessAttendance[]
  payrolls           Payroll[]
  documents          Document[]
  gatePasses         GatePass[]
  notifications      Notification[]
  workerProfile      WorkerProfile?
  reportedEmergencies EmergencyAlert[] @relation("ReportedEmergencies")
  acknowledgedEmergencies EmergencyAlert[] @relation("AcknowledgedEmergencies")
  pushSubscriptions   PushSubscription[]
  mealConfirmations   MealConfirmation[]
  hostelAdmissions    HostelAdmission[]
  bedAllocations      BedAllocation[]
  assetAssignments    AssetAssignment[]
  conductedInspections RoomInspection[] @relation("InspectorUser")
  incidentsInvolved   IncidentReport[]
}

model Room {
  id         String       @id @default(uuid()) @map("_id")
  block      String
  floor      Int
  roomNumber String
  capacity   Int
  category   RoomCategory @default(NON_AC)
  hostelId   String
  hostel     Hostel       @relation(fields: [hostelId], references: [id])
  isDeleted     Boolean      @default(false)
  isMaintenance Boolean      @default(false)
  // bedStatus: map of bedNumber -> status (AVAILABLE/OCCUPIED/RESERVED/MAINTENANCE)
  bedStatus  Json?        @default("{}")

  users        User[]
  inspections  RoomInspection[]
  bedAllocations BedAllocation[]

  @@unique([hostelId, block, floor, roomNumber])
}

model Attendance {
  id               String    @id @default(uuid()) @map("_id")
  date             DateTime  @default(now())
  isPresent        Boolean
  checkInTime      DateTime?
  checkOutTime     DateTime?
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  hostelId         String?
  roomNumber       String?
  session          String?
  status           String?
  scannedBy        String?
  scannerDevice    String?
  qrVerification   String?
  referenceCode    String?
  locationCode     String?
  scannerLatitude  Float?
  scannerLongitude Float?
  distanceMeters   Float?
  locationVerified Boolean?  @default(true)
}

model AttendanceQR {
  id            String    @id @default(uuid()) @map("_id")
  referenceCode String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  locationCode  String
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  status        String    @default("ACTIVE")
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}


model Leave {
  id        String   @id @default(uuid()) @map("_id")
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING")
  remarks   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hostelId  String?
  hostel    Hostel?  @relation(fields: [hostelId], references: [id])
  createdAt DateTime @default(now())
}

model Complaint {
  id              String            @id @default(uuid()) @map("_id")
  title           String
  description     String
  category        String
  priority        ComplaintPriority @default(MEDIUM)
  status          ComplaintStatus   @default(PENDING)
  resolutionImage String?
  studentFeedback String?
  feedbackRating  Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isDeleted       Boolean           @default(false)

  // SLA fields (additive)
  slaDeadline     DateTime?
  slaBreached     Boolean           @default(false)
  responseTime    Int?              // minutes to first assignment
  resolutionTime  Int?              // minutes to completion

  hostelId        String
  hostel          Hostel            @relation(fields: [hostelId], references: [id])

  studentId       String
  student         User              @relation("StudentComplaints", fields: [studentId], references: [id])

  staffId         String?
  staff           User?             @relation("StaffComplaints", fields: [staffId], references: [id])

  workerId        String?
  worker          User?             @relation("WorkerComplaints", fields: [workerId], references: [id])
  assignedBy      String?
  assignedAt      DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  startedAt       DateTime?
  completedAt     DateTime?
  completionNotes String?
  materialsUsed   String?
  reopenedAt      DateTime?
  reopenReason    String?

  timeline        ComplaintTimeline[]
  linkedInspection RoomInspection?   @relation(fields: [linkedInspectionId], references: [id])
  linkedInspectionId String?
}


model LaundrySlot {
  id           String   @id @default(uuid()) @map("_id")
  date         DateTime
  timeSlot     String
  status       String   @default("BOOKED")
  clothesCount Int?     @default(0)
  notes        String?
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  hostelId     String
  hostel       Hostel   @relation(fields: [hostelId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MessMenu {
  id        String  @id @default(uuid()) @map("_id")
  dayOfWeek String
  breakfast String
  lunch     String
  dinner    String
  hostelId  String
  hostel    Hostel  @relation(fields: [hostelId], references: [id])
  messId    String?
  mess      Mess?   @relation(fields: [messId], references: [id])
}

model Visitor {
  id                  String   @id @default(uuid()) @map("_id")
  name                String
  purpose             String
  visitDate           DateTime
  status              String   @default("PENDING")
  expectedArrivalTime DateTime?
  exitTime            DateTime?
  hostelId            String
  hostel              Hostel   @relation(fields: [hostelId], references: [id])
  studentId           String
  student             User     @relation(fields: [studentId], references: [id])
  checkInTime         DateTime?
  checkOutTime        DateTime?
  visitorPhone        String?
  relationship        String?
}

model AttendanceSettings {
  id                    String    @id @default(uuid()) @map("_id")
  enableQrAttendance    Boolean   @default(true)
  autoDateDetection     Boolean   @default(true)
  manualDateMode        Boolean   @default(false)
  manualDate            DateTime?
  manualSession         String?
  allowMultipleSessions Boolean   @default(false)
  enableCheckIn         Boolean   @default(true)
  enableCheckOut        Boolean   @default(true)
  timeWindow            Int       @default(60)
  cameraResolution      String    @default("720p")
  scanDelay             Int       @default(2)
  notificationsEnabled  Boolean   @default(true)
}

model AttendanceSession {
  id       String  @id @default(uuid()) @map("_id")
  name     String  @unique
  isActive Boolean @default(true)
}

model RolePermission {
  id         String @id @default(uuid()) @map("_id")
  role       Role
  permission String

  @@unique([role, permission])
}

model Mess {
  id          String           @id @default(uuid()) @map("_id")
  name        String
  messType    String?          @default("VEG")
  hostelId    String
  hostel      Hostel           @relation(fields: [hostelId], references: [id])
  students    User[]
  menus       MessMenu[]
  expenses    Expense[]
  attendances MessAttendance[]
  inventories Inventory[]
  meals       Meal[]
}

model MessAttendance {
  id        String   @id @default(uuid()) @map("_id")
  date      DateTime @default(now())
  mealType  String
  isPresent Boolean
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id])
  hostelId  String
}

model Meal {
  id            String             @id @default(uuid()) @map("_id")
  date          DateTime           // only the date portion
  type          String             // e.g. BREAKFAST, LUNCH, SNACKS, DINNER
  menu          String
  cutoffTime    DateTime
  mealTime      DateTime
  status        String             @default("ACTIVE") // ACTIVE, CANCELLED
  hostelId      String
  hostel        Hostel             @relation(fields: [hostelId], references: [id])
  messId        String?
  mess          Mess?              @relation(fields: [messId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  confirmations MealConfirmation[]
  wasteLog      MessWasteLog?

  @@unique([date, type, hostelId, messId])
}

model MealConfirmation {
  id        String   @id @default(uuid()) @map("_id")
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id])
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  status    String   @default("TAKING") // TAKING, SKIPPED
  updatedAt DateTime @updatedAt

  @@unique([mealId, studentId])
}

model Fee {
  id         String    @id @default(uuid()) @map("_id")
  title      String
  feeType    String?   @default("GENERAL")
  amount     Float
  dueDate    DateTime
  status     String
  paidAmount Float     @default(0)
  discount   Float?    @default(0)
  studentId  String
  student    User      @relation(fields: [studentId], references: [id])
  hostelId   String
  hostel     Hostel    @relation(fields: [hostelId], references: [id])
  payments   Payment[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Payment {
  id            String   @id @default(uuid()) @map("_id")
  amount        Float
  paymentMode   String
  transactionId String?
  receiptNumber String   @unique
  feeId         String
  fee           Fee      @relation(fields: [feeId], references: [id])
  studentId     String
  student       User     @relation(fields: [studentId], references: [id])
  hostelId      String
  hostel        Hostel   @relation(fields: [hostelId], references: [id])
  createdAt     DateTime @default(now())
}

model Inventory {
  id        String              @id @default(uuid()) @map("_id")
  itemName  String
  category  String
  quantity  Int
  unit      String
  minStock     Int                 @default(5)
  damagedCount Int                 @default(0)
  hostelId  String
  hostel    Hostel              @relation(fields: [hostelId], references: [id])
  messId    String?
  mess      Mess?               @relation(fields: [messId], references: [id])
  usages    InventoryUsage[]
  purchases InventoryPurchase[]
  ledger    InventoryLedger[]
}

model InventoryUsage {
  id          String    @id @default(uuid()) @map("_id")
  quantity    Int
  usedBy      String
  purpose     String?
  createdAt   DateTime  @default(now())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  hostelId    String
  hostel      Hostel    @relation(fields: [hostelId], references: [id])
}

model InventoryPurchase {
  id           String    @id @default(uuid()) @map("_id")
  quantity     Int
  cost         Float
  supplier     String?
  purchaseDate DateTime  @default(now())
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id])
  hostelId     String
  hostel       Hostel    @relation(fields: [hostelId], references: [id])
}

model Expense {
  id           String   @id @default(uuid()) @map("_id")
  category     String
  amount       Float
  description  String?
  expenseDate  DateTime @default(now())
  // Expense lifecycle (additive)
  approvalStatus String? @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, PAID
  approvedBy   String?
  approvedAt   DateTime?
  hostelId     String
  hostel       Hostel   @relation(fields: [hostelId], references: [id])
  messId       String?
  mess         Mess?    @relation(fields: [messId], references: [id])
}

model Payroll {
  id         String    @id @default(uuid()) @map("_id")
  staffId    String
  staff      User      @relation(fields: [staffId], references: [id])
  month      String
  baseSalary Float
  bonus      Float     @default(0)
  deductions Float     @default(0)
  advance    Float?    @default(0)
  pf         Float?    @default(0)
  esi        Float?    @default(0)
  netSalary  Float
  status     String
  paidDate   DateTime?
  payslipNo  String    @unique
  hostelId   String
  hostel     Hostel    @relation(fields: [hostelId], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  userEmail String
  action    String
  module    String
  details   String?
  createdAt DateTime @default(now())
}

model Document {
  id         String  @id @default(uuid()) @map("_id")
  name       String
  fileUrl    String
  docType    String? @default("OTHER")
  isVerified Boolean @default(false)
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  hostelId   String
  hostel     Hostel  @relation(fields: [hostelId], references: [id])
}

model GatePass {
  id             String         @id @default(uuid()) @map("_id")
  purpose        String
  destination    String
  expectedReturn DateTime
  actualReturn   DateTime?
  exitTime       DateTime?
  status         GatePassStatus @default(PENDING)
  qrCode         String?        @unique
  approvedBy     String?
  remarks        String?
  lateReturn     Boolean        @default(false)
  studentId      String
  student        User           @relation(fields: [studentId], references: [id])
  hostelId       String
  hostel         Hostel         @relation(fields: [hostelId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Notice {
  id          String         @id @default(uuid()) @map("_id")
  title       String
  content     String
  audience    NoticeAudience @default(ALL)
  isEmergency Boolean        @default(false)
  isPinned    Boolean        @default(false)
  hostelId    String?
  hostel      Hostel?        @relation(fields: [hostelId], references: [id])
  postedBy    String
  department  String?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Notification {
  id        String   @id @default(uuid()) @map("_id")
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model WorkerCategory {
  id          String   @id @default(uuid()) @map("_id")
  name        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workers     WorkerProfile[]
}

model WorkerProfile {
  id             String         @id @default(uuid()) @map("_id")
  workerId       String
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  categoryId     String
  category       WorkerCategory @relation(fields: [categoryId], references: [id])
  specialization String?
  hostelId       String?
  block          String?
  joiningDate    DateTime?      @default(now())
  status         String         @default("ACTIVE")
  availability   String         @default("AVAILABLE")
  assignedCount  Int            @default(0)
  completedCount Int            @default(0)
  rating         Float?         @default(5.0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ComplaintTimeline {
  id          String    @id @default(uuid()) @map("_id")
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  event       String
  title       String
  description String?
  actorName   String
  actorRole   String
  timestamp   DateTime  @default(now())
}

model EmergencyAlert {
  id               String    @id @default(uuid()) @map("_id")
  type             String
  level            String
  hostelId         String
  hostel           Hostel    @relation(fields: [hostelId], references: [id])
  block            String?
  floor            Int?
  roomId           String?
  roomNumber       String?
  message          String?
  reportedById     String
  reportedBy       User      @relation("ReportedEmergencies", fields: [reportedById], references: [id])
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AcknowledgedEmergencies", fields: [acknowledgedById], references: [id])
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
}

model LaundryWaitlist {
  id        String   @id @default(uuid()) @map("_id")
  timeSlot  String
  date      DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hostelId  String
  status    String   @default("WAITING")
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid()) @map("_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  hostelId  String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ACADEMIC YEAR
// ============================================================

model AcademicYear {
  id          String   @id @default(uuid()) @map("_id")
  label       String   @unique  // e.g. "2025-2026"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admissions  HostelAdmission[]
  bedAllocations BedAllocation[]
}

// ============================================================
// BED ALLOCATION HISTORY
// ============================================================

model BedAllocation {
  id             String       @id @default(uuid()) @map("_id")
  studentId      String
  student        User         @relation(fields: [studentId], references: [id])
  hostelId       String
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id])
  bedNumber      String
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  status         String       @default("ACTIVE") // ACTIVE, RELEASED, TRANSFERRED
  allocationDate DateTime     @default(now())
  releaseDate    DateTime?
  releaseReason  String?
  transferredTo  String?      // new roomId if transferred
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ============================================================
// HOSTEL ADMISSION WORKFLOW
// ============================================================

model HostelAdmission {
  id              String       @id @default(uuid()) @map("_id")
  studentId       String
  student         User         @relation(fields: [studentId], references: [id])
  hostelId        String?
  academicYearId  String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])

  // Application details
  preferredRoomCategory String?
  requestedHostelId     String?
  applicationNote       String?

  // Workflow status
  status          String       @default("PENDING")
  // PENDING | VERIFIED | APPROVED | REJECTED | WAITLIST | ALLOCATED | CHECKED_IN | CANCELLED

  // Admin fields
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  waitlistPosition Int?

  // Allocation fields
  allocatedRoomId String?
  allocatedBed    String?
  allocationDate  DateTime?

  // Check-in
  checkInDate     DateTime?
  checkInBy       String?

  // Fee reference
  feeGenerated    Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ============================================================
// ASSET MANAGEMENT
// ============================================================

model HostelAsset {
  id           String   @id @default(uuid()) @map("_id")
  assetCode    String   @unique
  category     String   // BED, MATTRESS, CHAIR, TABLE, CUPBOARD, FAN, KEY, OTHER
  description  String?
  hostelId     String
  roomId       String?
  roomNumber   String?
  block        String?
  condition    String   @default("GOOD") // GOOD, FAIR, POOR, DAMAGED, REPLACED
  status       String   @default("AVAILABLE") // AVAILABLE, ASSIGNED, UNDER_REPAIR, DISPOSED
  purchaseDate DateTime?
  purchaseCost Float?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments  AssetAssignment[]
}

model AssetAssignment {
  id           String      @id @default(uuid()) @map("_id")
  assetId      String
  asset        HostelAsset @relation(fields: [assetId], references: [id])
  studentId    String
  student      User        @relation(fields: [studentId], references: [id])
  assignedDate DateTime    @default(now())
  returnedDate DateTime?
  conditionAtAssign String @default("GOOD")
  conditionAtReturn String?
  damageNotes  String?
  damageAmount Float?      @default(0)
  status       String      @default("ASSIGNED") // ASSIGNED, RETURNED, DAMAGED
  assignedBy   String?
  returnedBy   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ============================================================
// ROOM INSPECTION
// ============================================================

model RoomInspection {
  id             String   @id @default(uuid()) @map("_id")
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id])
  hostelId       String
  inspectedById  String
  inspectedBy    User     @relation("InspectorUser", fields: [inspectedById], references: [id])
  inspectionDate DateTime @default(now())
  overallRating  String   @default("GOOD") // EXCELLENT, GOOD, FAIR, POOR

  // Per-item checks (stored as JSON for flexibility)
  checklist      Json?    // { cleanliness, bed, fan, light, door, lock, bathroom, furniture }

  damageFound    Boolean  @default(false)
  damageNotes    String?
  photosUrls     String[] @default([])
  actionRequired String?
  status         String   @default("OPEN") // OPEN, ACTION_TAKEN, CLOSED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  linkedComplaints Complaint[]
}

// ============================================================
// PREVENTIVE MAINTENANCE
// ============================================================

model PreventiveMaintenance {
  id              String   @id @default(uuid()) @map("_id")
  hostelId        String
  equipmentName   String   // Fire Extinguisher, Water Tank, Generator, RO Plant, etc.
  equipmentCode   String?
  category        String   @default("GENERAL") // FIRE_SAFETY, WATER, ELECTRICAL, CCTV, MECHANICAL, OTHER
  location        String?
  responsiblePerson String?
  frequencyDays   Int      @default(90) // service every N days
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  status          String   @default("OK") // OK, DUE, OVERDUE, IN_PROGRESS
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  history         MaintenanceServiceLog[]
}

model MaintenanceServiceLog {
  id             String                @id @default(uuid()) @map("_id")
  scheduleId     String
  schedule       PreventiveMaintenance @relation(fields: [scheduleId], references: [id])
  serviceDate    DateTime              @default(now())
  servicedBy     String
  notes          String?
  cost           Float?                @default(0)
  nextServiceDate DateTime?
  createdAt      DateTime              @default(now())
}

// ============================================================
// MESS WASTE TRACKING
// ============================================================

model MessWasteLog {
  id                String   @id @default(uuid()) @map("_id")
  mealId            String
  meal              Meal     @relation(fields: [mealId], references: [id])
  hostelId          String
  preparedQuantity  Float    @default(0)  // kg or litres
  consumedQuantity  Float    @default(0)
  wastedQuantity    Float    @default(0)
  unit              String   @default("kg")
  wastePercentage   Float?   @default(0)
  estimatedCost     Float?   @default(0)
  costPerStudent    Float?   @default(0)
  notes             String?
  loggedBy          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([mealId])
}

// ============================================================
// COMPLAINT SLA CONFIGURATION
// ============================================================

model ComplaintSLAConfig {
  id             String   @id @default(uuid()) @map("_id")
  hostelId       String   @unique
  highPriorityHours   Int @default(2)
  mediumPriorityHours Int @default(12)
  lowPriorityHours    Int @default(48)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// INVENTORY STOCK LEDGER
// ============================================================

model InventoryLedger {
  id          String    @id @default(uuid()) @map("_id")
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  hostelId    String
  txnType     String    // OPENING, PURCHASE, ISSUE, RETURN, DAMAGE, ADJUSTMENT, CLOSING
  quantity    Int       // positive = in, negative = out
  balanceAfter Int      // running balance after this txn
  referenceId String?   // purchase/usage id
  reason      String?
  performedBy String?
  createdAt   DateTime  @default(now())
}

// ============================================================
// FEE STRUCTURE TEMPLATES
// ============================================================

model FeeStructure {
  id           String   @id @default(uuid()) @map("_id")
  title        String
  feeType      String   @default("HOSTEL")
  amount       Float
  dueAfterDays Int      @default(30)  // due N days after generation
  hostelId     String
  academicYear String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// DISCIPLINE / INCIDENT MANAGEMENT
// ============================================================

model IncidentReport {
  id           String   @id @default(uuid()) @map("_id")
  studentId    String
  student      User     @relation(fields: [studentId], references: [id])
  hostelId     String
  incidentType String   // LATE_RETURN, UNAUTHORIZED_VISITOR, ROOM_DAMAGE, RULE_VIOLATION, NOISE, OTHER
  severity     String   @default("MINOR") // MINOR, MODERATE, SEVERE
  incidentDate DateTime @default(now())
  description  String
  actionTaken  String?
  warningIssued Boolean @default(false)
  fineAmount   Float?   @default(0)
  fineStatus   String?  @default("PENDING") // PENDING, PAID, WAIVED
  remarks      String?
  status       String   @default("OPEN") // OPEN, ACKNOWLEDGED, CLOSED
  reportedBy   String?
  linkedGatePassId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// HOSTEL CONFIG (Rules, Timings, Calendar)
// ============================================================

model HostelConfig {
  id        String   @id @default(uuid()) @map("_id")
  hostelId  String   @unique
  // Gate timings
  gateOpenTime     String?  @default("06:00")
  gateCloseTime    String?  @default("22:00")
  visitorStartTime String?  @default("09:00")
  visitorEndTime   String?  @default("20:00")
  nightAttendanceTime String? @default("21:30")
  outpassDeadline  String?  @default("20:00")
  // Mess timings
  breakfastStart   String?  @default("07:00")
  breakfastEnd     String?  @default("09:00")
  lunchStart       String?  @default("12:00")
  lunchEnd         String?  @default("14:00")
  snacksStart      String?  @default("16:00")
  snacksEnd        String?  @default("17:00")
  dinnerStart      String?  @default("19:00")
  dinnerEnd        String?  @default("21:00")
  // Rules
  hostelRules      String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HostelCalendar {
  id        String   @id @default(uuid()) @map("_id")
  hostelId  String
  date      DateTime
  dayType   String   // WORKING, WEEKEND, HOLIDAY, VACATION, EXAM
  label     String?
  notes     String?
  createdAt DateTime @default(now())

  @@unique([hostelId, date])
}

