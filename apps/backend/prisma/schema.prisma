datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  HOSTEL_ADMIN
  ASSISTANT_WARDEN
  MESS_MANAGER
  SECURITY
  MAINTENANCE
  ACCOUNTANT
  LAUNDRY
  STUDENT
  WORKER
}

enum StaffType {
  SECURITY
  LAUNDRY
  MAINTENANCE
  ELECTRICIAN
  PLUMBER
  CLEANING
  MESS
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  RESOLVED
  VERIFIED
  REOPENED
  CANCELLED
}


enum RoomCategory {
  AC
  NON_AC
  PREMIUM
  DORMITORY
}

enum GatePassStatus {
  PENDING
  APPROVED
  REJECTED
  EXITED
  RETURNED
}

enum NoticeAudience {
  ALL
  STUDENTS
  STAFF
  HOSTEL_ADMIN
  MESS_MANAGER
  SECURITY
  MAINTENANCE
}

model Hostel {
  id           String   @id @default(uuid()) @map("_id")
  name         String
  code         String   @unique
  collegeName  String
  address      String
  capacity     Int
  phone        String?
  email        String?
  logo         String?
  gender       String?  @default("MIXED")
  academicYear String?  @default("2025-2026")
  status       String?  @default("ACTIVE")
  wardenId     String?
  latitude     Float?   @default(13.0827)
  longitude    Float?   @default(80.2707)
  locationCode String?  @default("HSTL-MAIN-001")
  allowedRadius Float?  @default(5.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  rooms              Room[]
  complaints         Complaint[]
  laundrySlots       LaundrySlot[]
  messMenus          MessMenu[]
  visitors           Visitor[]
  messes             Mess[]
  fees               Fee[]
  payments           Payment[]
  inventories        Inventory[]
  inventoryUsages    InventoryUsage[]
  inventoryPurchases InventoryPurchase[]
  expenses           Expense[]
  payrolls           Payroll[]
  documents          Document[]
  leaves             Leave[]
  gatePasses         GatePass[]
  notices            Notice[]
  emergencies        EmergencyAlert[]
}

model User {
  id               String     @id @default(uuid()) @map("_id")
  email            String     @unique
  passwordHash     String
  fullName         String
  mobileNumber     String
  role             Role
  status           String     @default("PENDING")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  qrToken          String?    @unique
  isDeleted        Boolean    @default(false)

  collegeName      String?
  department       String?
  year             String?
  registerNumber   String?
  gender           String?
  parentName       String?
  parentMobile     String?
  emergencyContact String?
  address          String?

  photo            String?
  bloodGroup       String?
  medicalDetails   String?
  guardianName     String?
  guardianMobile   String?
  guardianRelation String?

  qualification    String?
  experience       String?
  staffType        StaffType?

  hostelId         String?
  hostel           Hostel?    @relation(fields: [hostelId], references: [id])

  roomId           String?
  room             Room?      @relation(fields: [roomId], references: [id])

  messId           String?
  mess             Mess?      @relation(fields: [messId], references: [id])

  attendances        Attendance[]
  attendanceQRs      AttendanceQR[]
  leaves             Leave[]
  complaintsRaised   Complaint[]      @relation("StudentComplaints")
  complaintsAssigned Complaint[]      @relation("StaffComplaints")
  workerAssignedComplaints Complaint[] @relation("WorkerComplaints")
  laundryBookings    LaundrySlot[]
  laundryWaitlists   LaundryWaitlist[]
  visitors           Visitor[]
  fees               Fee[]
  payments           Payment[]
  messAttendances    MessAttendance[]
  payrolls           Payroll[]
  documents          Document[]
  gatePasses         GatePass[]
  notifications      Notification[]
  workerProfile      WorkerProfile?
  reportedEmergencies EmergencyAlert[] @relation("ReportedEmergencies")
  acknowledgedEmergencies EmergencyAlert[] @relation("AcknowledgedEmergencies")
}

model Room {
  id         String       @id @default(uuid()) @map("_id")
  block      String
  floor      Int
  roomNumber String
  capacity   Int
  category   RoomCategory @default(NON_AC)
  hostelId   String
  hostel     Hostel       @relation(fields: [hostelId], references: [id])
  isDeleted  Boolean      @default(false)

  users      User[]

  @@unique([hostelId, block, floor, roomNumber])
}

model Attendance {
  id               String    @id @default(uuid()) @map("_id")
  date             DateTime  @default(now())
  isPresent        Boolean
  checkInTime      DateTime?
  checkOutTime     DateTime?
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  hostelId         String?
  roomNumber       String?
  session          String?
  status           String?
  scannedBy        String?
  scannerDevice    String?
  qrVerification   String?
  referenceCode    String?
  locationCode     String?
  scannerLatitude  Float?
  scannerLongitude Float?
  distanceMeters   Float?
  locationVerified Boolean?  @default(true)
}

model AttendanceQR {
  id            String    @id @default(uuid()) @map("_id")
  referenceCode String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  locationCode  String
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  status        String    @default("ACTIVE")
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}


model Leave {
  id        String   @id @default(uuid()) @map("_id")
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING")
  remarks   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hostelId  String?
  hostel    Hostel?  @relation(fields: [hostelId], references: [id])
  createdAt DateTime @default(now())
}

model Complaint {
  id              String            @id @default(uuid()) @map("_id")
  title           String
  description     String
  category        String
  priority        ComplaintPriority @default(MEDIUM)
  status          ComplaintStatus   @default(PENDING)
  resolutionImage String?
  studentFeedback String?
  feedbackRating  Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isDeleted       Boolean           @default(false)

  hostelId        String
  hostel          Hostel            @relation(fields: [hostelId], references: [id])

  studentId       String
  student         User              @relation("StudentComplaints", fields: [studentId], references: [id])

  staffId         String?
  staff           User?             @relation("StaffComplaints", fields: [staffId], references: [id])

  workerId        String?
  worker          User?             @relation("WorkerComplaints", fields: [workerId], references: [id])
  assignedBy      String?
  assignedAt      DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  startedAt       DateTime?
  completedAt     DateTime?
  completionNotes String?
  materialsUsed   String?
  reopenedAt      DateTime?
  reopenReason    String?

  timeline        ComplaintTimeline[]
}


model LaundrySlot {
  id           String   @id @default(uuid()) @map("_id")
  date         DateTime
  timeSlot     String
  status       String   @default("BOOKED")
  clothesCount Int?     @default(0)
  notes        String?
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  hostelId     String
  hostel       Hostel   @relation(fields: [hostelId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MessMenu {
  id        String  @id @default(uuid()) @map("_id")
  dayOfWeek String
  breakfast String
  lunch     String
  dinner    String
  hostelId  String
  hostel    Hostel  @relation(fields: [hostelId], references: [id])
  messId    String?
  mess      Mess?   @relation(fields: [messId], references: [id])
}

model Visitor {
  id                  String   @id @default(uuid()) @map("_id")
  name                String
  purpose             String
  visitDate           DateTime
  status              String   @default("PENDING")
  expectedArrivalTime DateTime?
  exitTime            DateTime?
  hostelId            String
  hostel              Hostel   @relation(fields: [hostelId], references: [id])
  studentId           String
  student             User     @relation(fields: [studentId], references: [id])
  checkInTime         DateTime?
  checkOutTime        DateTime?
  visitorPhone        String?
  relationship        String?
}

model AttendanceSettings {
  id                    String    @id @default(uuid()) @map("_id")
  enableQrAttendance    Boolean   @default(true)
  autoDateDetection     Boolean   @default(true)
  manualDateMode        Boolean   @default(false)
  manualDate            DateTime?
  manualSession         String?
  allowMultipleSessions Boolean   @default(false)
  enableCheckIn         Boolean   @default(true)
  enableCheckOut        Boolean   @default(true)
  timeWindow            Int       @default(60)
  cameraResolution      String    @default("720p")
  scanDelay             Int       @default(2)
  notificationsEnabled  Boolean   @default(true)
}

model AttendanceSession {
  id       String  @id @default(uuid()) @map("_id")
  name     String  @unique
  isActive Boolean @default(true)
}

model RolePermission {
  id         String @id @default(uuid()) @map("_id")
  role       Role
  permission String

  @@unique([role, permission])
}

model Mess {
  id          String           @id @default(uuid()) @map("_id")
  name        String
  messType    String?          @default("VEG")
  hostelId    String
  hostel      Hostel           @relation(fields: [hostelId], references: [id])
  students    User[]
  menus       MessMenu[]
  expenses    Expense[]
  attendances MessAttendance[]
  inventories Inventory[]
}

model MessAttendance {
  id        String   @id @default(uuid()) @map("_id")
  date      DateTime @default(now())
  mealType  String
  isPresent Boolean
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id])
  hostelId  String
}

model Fee {
  id         String    @id @default(uuid()) @map("_id")
  title      String
  feeType    String?   @default("GENERAL")
  amount     Float
  dueDate    DateTime
  status     String
  paidAmount Float     @default(0)
  discount   Float?    @default(0)
  studentId  String
  student    User      @relation(fields: [studentId], references: [id])
  hostelId   String
  hostel     Hostel    @relation(fields: [hostelId], references: [id])
  payments   Payment[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Payment {
  id            String   @id @default(uuid()) @map("_id")
  amount        Float
  paymentMode   String
  transactionId String?
  receiptNumber String   @unique
  feeId         String
  fee           Fee      @relation(fields: [feeId], references: [id])
  studentId     String
  student       User     @relation(fields: [studentId], references: [id])
  hostelId      String
  hostel        Hostel   @relation(fields: [hostelId], references: [id])
  createdAt     DateTime @default(now())
}

model Inventory {
  id        String              @id @default(uuid()) @map("_id")
  itemName  String
  category  String
  quantity  Int
  unit      String
  minStock  Int                 @default(5)
  hostelId  String
  hostel    Hostel              @relation(fields: [hostelId], references: [id])
  messId    String?
  mess      Mess?               @relation(fields: [messId], references: [id])
  usages    InventoryUsage[]
  purchases InventoryPurchase[]
}

model InventoryUsage {
  id          String    @id @default(uuid()) @map("_id")
  quantity    Int
  usedBy      String
  purpose     String?
  createdAt   DateTime  @default(now())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  hostelId    String
  hostel      Hostel    @relation(fields: [hostelId], references: [id])
}

model InventoryPurchase {
  id           String    @id @default(uuid()) @map("_id")
  quantity     Int
  cost         Float
  supplier     String?
  purchaseDate DateTime  @default(now())
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id])
  hostelId     String
  hostel       Hostel    @relation(fields: [hostelId], references: [id])
}

model Expense {
  id          String   @id @default(uuid()) @map("_id")
  category    String
  amount      Float
  description String?
  expenseDate DateTime @default(now())
  hostelId    String
  hostel      Hostel   @relation(fields: [hostelId], references: [id])
  messId      String?
  mess        Mess?    @relation(fields: [messId], references: [id])
}

model Payroll {
  id         String    @id @default(uuid()) @map("_id")
  staffId    String
  staff      User      @relation(fields: [staffId], references: [id])
  month      String
  baseSalary Float
  bonus      Float     @default(0)
  deductions Float     @default(0)
  advance    Float?    @default(0)
  pf         Float?    @default(0)
  esi        Float?    @default(0)
  netSalary  Float
  status     String
  paidDate   DateTime?
  payslipNo  String    @unique
  hostelId   String
  hostel     Hostel    @relation(fields: [hostelId], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  userEmail String
  action    String
  module    String
  details   String?
  createdAt DateTime @default(now())
}

model Document {
  id         String  @id @default(uuid()) @map("_id")
  name       String
  fileUrl    String
  docType    String? @default("OTHER")
  isVerified Boolean @default(false)
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  hostelId   String
  hostel     Hostel  @relation(fields: [hostelId], references: [id])
}

model GatePass {
  id             String         @id @default(uuid()) @map("_id")
  purpose        String
  destination    String
  expectedReturn DateTime
  actualReturn   DateTime?
  exitTime       DateTime?
  status         GatePassStatus @default(PENDING)
  qrCode         String?        @unique
  approvedBy     String?
  remarks        String?
  lateReturn     Boolean        @default(false)
  studentId      String
  student        User           @relation(fields: [studentId], references: [id])
  hostelId       String
  hostel         Hostel         @relation(fields: [hostelId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Notice {
  id          String         @id @default(uuid()) @map("_id")
  title       String
  content     String
  audience    NoticeAudience @default(ALL)
  isEmergency Boolean        @default(false)
  isPinned    Boolean        @default(false)
  hostelId    String?
  hostel      Hostel?        @relation(fields: [hostelId], references: [id])
  postedBy    String
  department  String?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Notification {
  id        String   @id @default(uuid()) @map("_id")
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model WorkerCategory {
  id          String   @id @default(uuid()) @map("_id")
  name        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workers     WorkerProfile[]
}

model WorkerProfile {
  id             String         @id @default(uuid()) @map("_id")
  workerId       String
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  categoryId     String
  category       WorkerCategory @relation(fields: [categoryId], references: [id])
  specialization String?
  hostelId       String?
  block          String?
  joiningDate    DateTime?      @default(now())
  status         String         @default("ACTIVE")
  availability   String         @default("AVAILABLE")
  assignedCount  Int            @default(0)
  completedCount Int            @default(0)
  rating         Float?         @default(5.0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ComplaintTimeline {
  id          String    @id @default(uuid()) @map("_id")
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  event       String
  title       String
  description String?
  actorName   String
  actorRole   String
  timestamp   DateTime  @default(now())
}

model EmergencyAlert {
  id               String    @id @default(uuid()) @map("_id")
  type             String
  level            String
  hostelId         String
  hostel           Hostel    @relation(fields: [hostelId], references: [id])
  block            String?
  floor            Int?
  roomId           String?
  roomNumber       String?
  message          String?
  reportedById     String
  reportedBy       User      @relation("ReportedEmergencies", fields: [reportedById], references: [id])
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AcknowledgedEmergencies", fields: [acknowledgedById], references: [id])
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
}

model LaundryWaitlist {
  id        String   @id @default(uuid()) @map("_id")
  timeSlot  String
  date      DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hostelId  String
  status    String   @default("WAITING")
  createdAt DateTime @default(now())
}

